#!/sbin/openrc-run

description="nic - network interface configurator"
command="@PREFIX@/sbin/nic"
command_args="start --daemon"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=3
respawn_period=30
extra_started_commands="reload"

depend() {
    need localmount
    before net dns
    after udev
    provide net
}

reload() {
    ebegin "Reloading nic"
    "${command}" reload --force --no-rollback
    eend $?
}
